ARGOS_APP_NAME=ARGOS
ARGOS_ENVIRONMENT=development
ARGOS_API_HOST=0.0.0.0
ARGOS_API_PORT=8000
ARGOS_API_ROOT_PATH=
ARGOS_CORS_ORIGINS=["http://localhost:3000"]

ARGOS_DATABASE__URL=postgresql+asyncpg://argos:argos@postgres:5432/argos
ARGOS_DATABASE__ECHO=false
ARGOS_DATABASE__POOL_SIZE=10
ARGOS_DATABASE__MAX_OVERFLOW=20

ARGOS_REDIS__URL=redis://redis:6379/0
ARGOS_REDIS__SOCKET_TIMEOUT_SECONDS=5.0

ARGOS_QDRANT__URL=http://qdrant:6333

ARGOS_LLM__DEFAULT_MODEL=
ARGOS_LLM__DROP_PARAMS=true

ARGOS_TELEMETRY__SERVICE_NAME=argos-api
ARGOS_TELEMETRY__SERVICE_VERSION=0.1.0
ARGOS_TELEMETRY__ENABLE_CONSOLE_EXPORT=false
ARGOS_TELEMETRY__SAMPLING_RATIO=1.0
ARGOS_TELEMETRY__LANGSMITH_TRACING=false
ARGOS_TELEMETRY__LANGSMITH_PROJECT=argos
